PORT=3001

# Produção (dinheiro cai na conta em que você copiou as chaves):
# MP_ACCESS_TOKEN e MP_PUBLIC_KEY começam com APP_USR-
# Teste (não cobra): prefixo TEST-
# Nunca commite o arquivo .env nem cole o Access Token no GitHub.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# true = demonstração local, sem Mercado Pago
# false = cobra de verdade se o token for APP_USR-
DEMO_PAYMENTS=true

# true = sandbox mesmo com token APP_USR- (não use isso em produção)
MP_TEST_MODE=true

# Em produção (live) a lista é obrigatória. Sem ela o navegador não chama a API.
MAX_INSTALLMENTS=3
FREE_SHIPPING_FROM=360
PUBLIC_SITE_URL=http://127.0.0.1:3001
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8080,http://127.0.0.1:8080,https://gabriel7z.github.io
